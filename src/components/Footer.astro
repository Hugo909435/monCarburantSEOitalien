---
// Footer a 4 colonne
import { SITE } from '../config/site';
import { FUELS, FUEL_KEYS } from '../lib/fuel';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-grid">
    <!-- Colonna 1: il sito -->
    <div class="footer-col">
      <a href="/" class="footer-logo" aria-label={`${SITE.name} - Home`}>
        <img src="/images/logo-transparent.svg" alt={SITE.name} class="footer-logo-img" width="36" height="36" />
        <span>{SITE.logoA}<strong>{SITE.logoB}</strong></span>
      </a>
      <p class="footer-tagline">
        {SITE.tagline} Prezzi ufficiali comunicati dai gestori al Ministero, aggiornati ogni giorno.
      </p>
    </div>

    <!-- Colonna 2: prezzi -->
    <div class="footer-col">
      <p class="footer-heading">Prezzi carburanti</p>
      <ul role="list">
        {FUEL_KEYS.map((k) => (
          <li><a href={`/${FUELS[k].slug}/`}>Prezzo {FUELS[k].label.toLowerCase() === 'gpl' ? 'GPL' : FUELS[k].label.toLowerCase()} oggi</a></li>
        ))}
        <li><a href="/prezzi-carburanti/province/">Prezzi per provincia</a></li>
        <li><a href="/prezzi-carburanti/marca/">Prezzi per marchio</a></li>
        <li><a href="/prezzi-carburanti/autostrada/">Prezzi in autostrada</a></li>
      </ul>
    </div>

    <!-- Colonna 3: informazioni -->
    <div class="footer-col">
      <p class="footer-heading">Informazioni</p>
      <ul role="list">
        <li><a href="/chi-siamo/">Chi siamo</a></li>
        <li><a href="/prezzi-carburanti/metodologia/">Metodologia</a></li>
        <li><a href="/note-legali/">Note legali</a></li>
        <li><a href="/privacy/">Privacy e cookie</a></li>
      </ul>
    </div>

    <!-- Colonna 4: contatti -->
    <div class="footer-col">
      <p class="footer-heading">Contatti</p>
      <p>Un prezzo sbagliato, una domanda o una proposta di collaborazione?</p>
      <a href="/contatti/" class="footer-cta">Scrivici</a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {currentYear} {SITE.name}, tutti i diritti riservati</p>
      <p class="footer-datasource">
        Fonte dei dati: <a href={SITE.dataSource.url} rel="noopener noreferrer" target="_blank">{SITE.dataSource.label}</a>
        (<a href={SITE.dataSource.licenceUrl} rel="noopener noreferrer license" target="_blank">{SITE.dataSource.licence}</a>). Sito non ufficiale.
      </p>
      <nav aria-label="Navigazione legale">
        <a href="/note-legali/">Note legali</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: #cbd5e1;
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
    }
  }

  .footer-col .footer-heading {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    margin: 0 0 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .footer-logo-img {
    display: block;
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: 6px;
  }

  .footer-logo:hover {
    color: #fff;
  }

  .footer-logo strong {
    color: var(--color-accent);
    font-weight: 800;
  }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col a {
    font-size: 0.875rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-col p {
    font-size: 0.875rem;
    color: #94a3b8;
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  .footer-cta {
    display: inline-flex;
    padding: 0.5rem 1rem;
    background: var(--color-accent);
    color: #fff !important;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .footer-cta:hover {
    background: #d0651a;
    color: #fff;
  }

  .footer-socials {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #334155;
    border-radius: 0.375rem;
    color: #94a3b8;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }

  .footer-socials a:hover {
    background: rgba(255 255 255 / 0.08);
    border-color: var(--color-accent);
    color: #fff;
  }

  .footer-socials svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
  }

  .footer-bottom {
    border-top: 1px solid #1e3a50;
  }

  .footer-datasource {
    margin: 0;
    font-size: 0.75rem;
    color: #475569;
  }
  .footer-datasource a {
    color: #64748b;
    text-decoration: underline;
  }
  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    font-size: 0.8125rem;
    color: #64748b;
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-bottom-inner p {
    margin: 0;
  }

  .footer-bottom nav {
    display: flex;
    gap: 1.25rem;
  }

  .footer-bottom nav a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-bottom nav a:hover {
    color: #94a3b8;
  }
</style>
