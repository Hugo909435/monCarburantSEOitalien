---
// Mappa di un gruppo ristretto di impianti (comune, autostrada).
// Leaflet è caricato solo quando la mappa entra nello schermo.
import { prezzo, nomeImpianto, type Impianto } from '../lib/fuel';

interface Props {
  stations: Impianto[];
  label: string;
}

const { stations, label } = Astro.props;
const points = stations.map((s) => [
  s.lat, s.lng, nomeImpianto(s), s.addr,
  s.p.benzina != null ? prezzo(s.p.benzina) : null,
  s.p.gasolio != null ? prezzo(s.p.gasolio) : null,
]);
---

<div class="pp-map" data-local-map data-points={JSON.stringify(points)} role="application" aria-label={label}></div>

<script>
  import { escapeHtml } from '../utils/escape-html';

  const load = (tag: 'link' | 'script', url: string) =>
    new Promise<void>((resolve) => {
      const el = document.createElement(tag) as any;
      if (tag === 'link') { el.rel = 'stylesheet'; el.href = url; } else { el.src = url; }
      el.onload = () => resolve();
      el.onerror = () => resolve();
      document.head.appendChild(el);
    });

  async function init(el: HTMLElement) {
    await load('link', '/vendor/leaflet/leaflet.css');
    await load('script', '/vendor/leaflet/leaflet.js');
    const L = (window as any).L;
    if (!L) return;
    const points: [number, number, string, string, string | null, string | null][] = JSON.parse(el.dataset.points || '[]');
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    const markers = points.map(([lat, lng, name, addr, benzina, gasolio]) =>
      L.circleMarker([lat, lng], { radius: 7, color: '#fff', weight: 2, fillColor: '#E87722', fillOpacity: 1 })
        .bindPopup(
          `<strong>${escapeHtml(name)}</strong><br>${escapeHtml(addr)}` +
          (benzina ? `<br>Benzina ${benzina} €/L` : '') +
          (gasolio ? `<br>Gasolio ${gasolio} €/L` : ''),
        )
        .addTo(map),
    );
    if (markers.length === 1) map.setView([points[0][0], points[0][1]], 14);
    else map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [28, 28], maxZoom: 15 });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        observer.unobserve(e.target);
        init(e.target as HTMLElement);
      });
    },
    { rootMargin: '300px' },
  );
  document.querySelectorAll<HTMLElement>('[data-local-map]').forEach((el) => observer.observe(el));
</script>
